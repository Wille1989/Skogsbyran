
# Set in .env.local and in the deployment build environment, then restart/rebuild.
# 12-64 lowercase letters, digits or hyphens; first character must be alphanumeric.
# Generate a value: node -e "console.log(require('node:crypto').randomBytes(16).toString('hex'))"
# No default login route is enabled when this is empty or invalid.
VITE_ADMIN_LOGIN_SLUG=
VITE_BACKEND_URL=
